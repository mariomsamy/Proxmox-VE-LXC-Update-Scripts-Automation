[Unit]
Description=Proxmox VE LXC Auto Update (running containers only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lxc-auto-update.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
LockPersonality=true
UMask=0027
